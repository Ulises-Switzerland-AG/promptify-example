# Runtime login (SELECT/INSERT/UPDATE/DELETE only). In Azure: Key Vault reference.
DATABASE_URL=

# Migration login (DDL). Only available to the deployment pipeline.
MIGRATION_DATABASE_URL=

# Application Insights connection string (audit events). In Azure: Key Vault reference.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Seed: oid of the first Administrator (run from the pipeline).
FIRST_ADMINISTRATOR_OID=

# Local development only. Ignored when NODE_ENV=production.
PROMPTIFY_DEV_USER_OID=
PROMPTIFY_DEV_USER_NAME=
